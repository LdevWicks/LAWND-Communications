service cloud.firestore {
  match /databases/{database}/documents {

    // Public site content — read by anonymous visitors on the
    // computer-science / entrepreneurship / nonprofit / entertainment pages.
    // Only a signed-in user (the site owner, via the MFA login) can write.
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ceo/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /lawnd/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /nonprofit/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /teaProducts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /YVideos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // CI/CD pipeline status shown in the authenticated operations dashboard.
    // Written by a trusted backend via the Admin SDK (bypasses these rules),
    // never directly by a client.
    match /pipeline-status/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
